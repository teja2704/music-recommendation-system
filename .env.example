# Copy this file to .env for local development. Never commit real values.
SPOTIFY_CLIENT_ID=replace_with_your_client_id
SPOTIFY_CLIENT_SECRET=replace_with_your_rotated_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

